# J26-IT-449 — optional local web configuration TEMPLATE.
# Copy to .env for future website work. Never commit the resulting .env file.
# This template is NOT loaded automatically by the existing Gradio demo.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

